<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Win10.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/wp_black</item>
        <item name="android:statusBarColor">@color/wp_black</item>
        <item name="android:navigationBarColor">@color/wp_black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowAnimationStyle">@style/Anim.Instant</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Win10.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/wp_white</item>
        <item name="android:statusBarColor">@color/wp_white</item>
        <item name="android:navigationBarColor">@color/wp_white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowAnimationStyle">@style/Anim.Instant</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Anim.Instant" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/none</item>
        <item name="android:windowExitAnimation">@anim/none</item>
        <item name="android:activityOpenEnterAnimation">@anim/none</item>
        <item name="android:activityOpenExitAnimation">@anim/none</item>
        <item name="android:activityCloseEnterAnimation">@anim/none</item>
        <item name="android:activityCloseExitAnimation">@anim/none</item>
    </style>

    <!-- Transparent window so the page can swing open over Start. -->
    <style name="Theme.Win10.Dark.Page" parent="Theme.Win10.Dark">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Anim.Instant</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="Theme.Win10.Light.Page" parent="Theme.Win10.Light">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Anim.Instant</item>
        <item name="android:navigationBarColor">@color/wp_white</item>
        <item name="android:statusBarColor">@color/wp_white</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
